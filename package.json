{
  "name": "tous-mes-mots",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Persönlicher Vokabeltrainer Französisch (FSRS, offline, ein Nutzer)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "import": "tsx scripts/import.ts",
    "import:check": "tsx scripts/import.ts --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "rueckfragen": "tsx scripts/rueckfragen.ts",
    "daten": "npm run import && npm run rueckfragen && tsx scripts/vault.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "fake-indexeddb": "^6.2.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "ts-fsrs": "^6.0.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
